# Audiobookshelf Docker Setup - Environment Variables Template
# Copy this file to .env and fill in your values

# Network Configuration
LOCAL_IP=YOUR_LOCAL_IP
ABS_PORT=13378

# NAS Configuration (if using network storage)
NAS_IP=192.168.0.X
NAS_SHARE_PATH=/media/Audiobooks
NAS_MOUNT_POINT=/mnt/nas-audiobooks
NAS_USERNAME=your_username
# Store password in separate secure file

# Cloudflare Configuration (for public access)
CF_TUNNEL_NAME=audiobookshelf-public
CF_DOMAIN=abs.yourdomain.com

# Paths
ABS_CONFIG_PATH=/srv/docker/volumes/audiobookshelf/config
ABS_METADATA_PATH=/srv/docker/volumes/audiobookshelf/metadata
ABS_AUDIOBOOKS_PATH=/srv/docker/volumes/audiobookshelf/audiobooks
ABS_PODCASTS_PATH=/srv/docker/volumes/audiobookshelf/podcasts

# Service Configuration
TIMEZONE=America/Los_Angeles
CONTAINER_NAME=audiobookshelf

# Resource Limits
CPU_LIMIT=2.0
CPU_RESERVATION=0.5
MEMORY_LIMIT=2G
MEMORY_RESERVATION=512M
